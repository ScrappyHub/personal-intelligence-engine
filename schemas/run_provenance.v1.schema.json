{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pie.local/schemas/run_provenance.v1.schema.json",
  "title": "PIE run provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "run_id", "recorded_utc", "backend", "adapter_script_sha256",
    "model_id", "model_manifest_sha256", "model_content_sha256", "model_identity_source",
    "model_identity_verified", "backend_binding_verified", "inference_certified",
    "persona_sha256", "effective_prompt_sha256", "params", "params_sha256",
    "input_sha256", "output_sha256", "record_line_sha256"
  ],
  "properties": {
    "schema": { "const": "pie.run.provenance.v1" },
    "run_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "recorded_utc": { "type": "string", "format": "date-time" },
    "backend": { "enum": ["stub", "ollama", "llamacpp", "onnx"] },
    "adapter_script_sha256": { "$ref": "#/$defs/sha256" },
    "adapter_contract_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "model_id": { "type": "string", "minLength": 1 },
    "model_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "model_content_sha256": { "$ref": "#/$defs/sha256" },
    "model_identity_source": { "enum": ["sha256sums", "ollama_local_digest", "manifest_only"] },
    "model_identity_verified": { "type": "boolean" },
    "backend_binding_verified": { "type": "boolean" },
    "inference_certified": { "type": "boolean" },
    "persona_sha256": { "$ref": "#/$defs/sha256" },
    "effective_prompt_sha256": { "$ref": "#/$defs/sha256" },
    "params": { "type": "object" },
    "params_sha256": { "$ref": "#/$defs/sha256" },
    "input_sha256": { "$ref": "#/$defs/sha256" },
    "output_sha256": { "$ref": "#/$defs/sha256" },
    "record_line_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
