{
  "name": "pie-desktop",
  "productName": "PIE",
  "version": "0.1.0",
  "description": "Private local AI workspace",
  "main": "main.js",
  "author": "PIE contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron-forge start",
    "stage-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-runtime.ps1",
    "prepackage": "npm run stage-runtime",
    "package": "electron-forge package",
    "premake": "npm run stage-runtime",
    "make": "electron-forge make",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\scripts\\verify_pie_desktop_release_v1.ps1 -RepoRoot .. -AllowUnsigned",
    "release": "npm run make && npm run verify"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "electron": "43.2.0"
  },
  "overrides": {
    "tar": "7.5.21",
    "tmp": "0.2.7"
  }
}
